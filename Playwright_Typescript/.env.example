# Environment Configuration for Playwright Tests

# Base URL for the application
BASE_URL=http://localhost:3000

# Test execution settings
TEST_TIMEOUT=60000
WORKERS=4

# CI/CD Environment
CI=false

# Optional: Web Server Configuration
WEB_SERVER_CMD=npm run dev

# Optional: Global Setup/Teardown
# GLOBAL_SETUP=config/global-setup.ts
# GLOBAL_TEARDOWN=config/global-teardown.ts

# Optional: HTTP Authentication
# HTTP_USERNAME=
# HTTP_PASSWORD=

# Logging levels
DEBUG=false
LOG_LEVEL=info

# Test Environment
TEST_ENV=local
